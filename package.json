{
  "name": "mundo-de-song",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "lint": "eslint src tools test eslint.config.js",
    "check": "npm run lint && npm run check:modules && npm run check:conteudo",
    "check:modules": "node --experimental-vm-modules tools/check-project.mjs",
    "check:conteudo": "node tools/revisar-conteudo.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "npm run check && node tools/build.mjs",
    "validate": "npm run check && npm test && npm run art:check && npm run art:references && node tools/build.mjs",
    "art:check": "node tools/check-art.mjs",
    "art:render": "node tools/render-art.mjs",
    "art:catalog": "node tools/art-catalog.mjs",
    "art:scenes": "node tools/render-art-scene.mjs",
    "art:og": "node tools/render-og.mjs",
    "art:library": "node tools/export-sprite-kit.mjs",
    "art:references": "node tools/references/check.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "eslint": "10.13.0"
  },
  "description": "RPG educacional em pixel art para navegadores, publicado no GitHub Pages",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
